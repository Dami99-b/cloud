ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://filestore:filestore@localhost:5432/filestore

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=user-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

MULTIPART_THRESHOLD_BYTES=52428800
MULTIPART_CHUNK_SIZE_BYTES=5242880
PRESIGN_EXPIRY_SECONDS=3600

WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=5

DEFAULT_OWNER_ID=00000000-0000-0000-0000-000000000001
